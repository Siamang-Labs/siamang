{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siamang.org/schemas/questionnaire-1.0.json",
  "title": "Siamang questionnaire document",
  "description": "A questionnaire as stored by a survey builder: the same objects as siamang.core, one JSON object per engine class. Written by siamang.model.to_document, read by siamang.model.from_document.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "quotas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quota"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      }
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "layout": {
      "description": "Builder-owned state (collapsed pages, logic-map positions); ignored by the engine.",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "title",
    "pages"
  ],
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "code": {
      "description": "An answer code as used in Variable.labels: an integer, a number or a string.",
      "type": [
        "integer",
        "number",
        "string"
      ]
    },
    "varref": {
      "type": "object",
      "properties": {
        "type": {
          "const": "var"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "operand": {
      "anyOf": [
        {
          "$ref": "#/$defs/expression"
        },
        {
          "$ref": "#/$defs/varref"
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "$ref": "#/$defs/varref"
              }
            ]
          }
        }
      ]
    },
    "expression": {
      "description": "Expression AST, as produced by Expression.to_dict().",
      "type": "object",
      "properties": {
        "type": {
          "const": "expression"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "in",
            "not in",
            "and",
            "or",
            "not",
            "raw"
          ]
        },
        "left": {
          "$ref": "#/$defs/operand"
        },
        "right": {
          "$ref": "#/$defs/operand"
        }
      },
      "required": [
        "type",
        "op"
      ],
      "additionalProperties": false
    },
    "condition": {
      "description": "A visibility or branching condition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "raw"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/expression"
        },
        {
          "$ref": "#/$defs/varref"
        }
      ]
    },
    "media": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ]
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "autoplay": {
          "type": "boolean"
        },
        "loop": {
          "type": "boolean"
        },
        "controls": {
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "media": {
          "$ref": "#/$defs/media"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "additionalProperties": false
    },
    "labels": {
      "description": "Value labels in display order. The object form is accepted as shorthand.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/$defs/code"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "variable": {
      "type": "object",
      "properties": {
        "scale": {
          "enum": [
            "interval",
            "nominal",
            "ordinal",
            "ratio"
          ]
        },
        "label": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/$defs/code"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "dont_know",
                  "not_applicable",
                  "not_asked",
                  "refusal",
                  "system_missing"
                ]
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "missing_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "missing_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dtype": {
          "enum": [
            "bool",
            "category",
            "datetime",
            "float",
            "int",
            "str"
          ]
        },
        "role": {
          "enum": [
            "derived",
            "grouping",
            "id",
            "input",
            "target",
            "weight"
          ]
        },
        "description": {
          "type": "string"
        },
        "construct": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "valid_range": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "scale"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Block"
        },
        "title": {
          "type": "string"
        },
        "randomize": {
          "type": "boolean"
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "content",
            "disqualification",
            "final",
            "redirect"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "redirect_url": {
          "type": "string"
        },
        "redirect_delay": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "next_if": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/condition"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          }
        },
        "default_next": {
          "type": "string",
          "minLength": 1
        },
        "randomize_blocks": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "quota": {
      "type": "object",
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "target_value": {
          "$ref": "#/$defs/code"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "variable",
        "target_value",
        "limit"
      ],
      "additionalProperties": false
    },
    "script": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "trigger": {
              "enum": [
                "onAnswer",
                "onInit",
                "onPageEnter",
                "onPageExit",
                "onQuestionShow",
                "onRandomize",
                "onSubmit"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "object"
            },
            "sandbox": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "randomize_options"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "randomize_pages"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timed_question"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "question",
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "validate_fields_match"
            },
            "field_a": {
              "type": "string",
              "minLength": 1
            },
            "field_b": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "field_a",
            "field_b"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SingleChoice": {
      "type": "object",
      "properties": {
        "type": {
          "const": "SingleChoice"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "var": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "skip_to": {
          "type": "string",
          "minLength": 1
        },
        "randomize": {
          "type": "boolean"
        },
        "other_specify": {
          "type": "boolean"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              }
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "display": {
          "enum": [
            "radio",
            "dropdown",
            "buttons"
          ]
        },
        "none_of_above": {
          "type": "boolean"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "id",
        "text",
        "var"
      ],
      "additionalProperties": false
    },
    "MultiChoice": {
      "type": "object",
      "properties": {
        "type": {
          "const": "MultiChoice"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "var": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "skip_to": {
          "type": "string",
          "minLength": 1
        },
        "randomize": {
          "type": "boolean"
        },
        "other_specify": {
          "type": "boolean"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              }
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "min_answers": {
          "type": "integer",
          "minimum": 0
        },
        "max_answers": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "mode": {
          "enum": [
            "array",
            "wide"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "id",
        "text",
        "var"
      ],
      "additionalProperties": false
    },
    "LikertScale": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LikertScale"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "var": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "skip_to": {
          "type": "string",
          "minLength": 1
        },
        "randomize": {
          "type": "boolean"
        },
        "other_specify": {
          "type": "boolean"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              }
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "points": {
          "type": "integer",
          "minimum": 2
        },
        "left_label": {
          "type": "string"
        },
        "right_label": {
          "type": "string"
        },
        "na_option": {
          "type": [
