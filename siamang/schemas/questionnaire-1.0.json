          "const": "NumericInput"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "var": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
