            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "hide_if": {
          "$ref": "#/$defs/condition"
        },
        "skip_to": {
          "type": "string",
          "minLength": 1
        },
        "randomize": {
          "type": "boolean"
        },
        "other_specify": {
          "type": "boolean"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              }
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "display": {
          "enum": [
            "input",
            "slider"
