    "OpenText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "OpenText"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "var": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
