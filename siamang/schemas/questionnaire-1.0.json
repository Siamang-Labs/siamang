        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/media"
            },
            {
              "type": "array",
