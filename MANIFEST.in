include README.md CHANGELOG.md LICENSE LICENSE-COMMERCIAL.md MANIFEST.in
include pyproject.toml

recursive-include siamang *.tpl *.jsx *.js *.json *.yaml py.typed
recursive-include siamang/frontend/templates/react/fonts *.woff2 *.txt *.md
# The chart libraries a report with interactive charts carries, with their licenses.
recursive-include siamang/reporting/assets LICENSE-* README.md THIRD-PARTY-NOTICES.txt
recursive-include docs *.md
recursive-include examples *.py

global-exclude *.map
global-exclude *.ts
global-exclude *.tsx
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
